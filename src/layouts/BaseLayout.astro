---
import '@styles/global.css';
import Seo from '@components/Seo.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Home: header floats over the full-bleed hero. */
  headerOverlay?: boolean;
  /** Target of the header's "Talk to us" (pages without a #contact band pass '/#contact'). */
  contactHref?: string;
  /** Footer note for pages that use AI-generated imagery. */
  imageryNote?: boolean;
}

const { title, description, image, noindex, headerOverlay, contactHref, imageryNote } = Astro.props;
---

<!doctype html>
<!-- v3: dark-primary (D10). Every colour role flips from this one attribute. -->
<html lang="en-IN" data-surface="inverse">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0E1013" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link
      rel="preload"
      href="/fonts/IBMPlexSans-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <Seo title={title} description={description} image={image} noindex={noindex} />
  </head>

  <body>
    <Header overlay={headerOverlay} contactHref={contactHref} />
    <main id="main">
      <slot />
    </main>
    <Footer imageryNote={imageryNote} />
  </body>
</html>
