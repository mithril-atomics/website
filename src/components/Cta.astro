---
import Button from './Button.astro';
import { cta } from '@content/site';
---

<section class="cta" data-surface="inverse">
  <div class="wrap wrap--wide">
    <p class="cta__statement">{cta.statement}</p>
    <div class="cta__body">
      <h2 class="cta__heading">{cta.heading}</h2>
      <p class="cta__text">{cta.body}</p>
      <p class="cta__action">
        <Button href={cta.action.href}>
          {cta.action.label}
          <span aria-hidden="true">&#8594;</span>
        </Button>
      </p>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: var(--section-y); }

  .cta__statement {
    margin: 0 0 var(--space-2xl);
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    color: var(--ink);
    max-width: 20ch;
    text-wrap: balance;
  }

  .cta__body { max-width: var(--measure); }

  .cta__heading {
    margin: 0 0 var(--space-sm);
    font-size: var(--text-2xl);
  }

  .cta__text {
    margin: 0;
    color: var(--ink-muted);
    line-height: var(--leading-relaxed);
  }

  .cta__action { margin: var(--space-lg) 0 0; }
</style>
