---
/**
 * The closing contact band (#contact) — present on every page so the header's
 * "Talk to us" always has a target. Display-scale statement, hairline, then
 * body copy and the mailto action.
 */
import Button from './Button.astro';
import { cta, company, ui } from '@content/site';

interface Props {
  /** Optional eyebrow above the statement (Home uses "The Bigger Picture"). */
  label?: string;
  /** Statement size — `display` on Home, `display-sm` elsewhere. */
  size?: 'display' | 'display-sm';
  /** Show the plain email address beside the button. */
  showEmail?: boolean;
}

const { label, size = 'display-sm', showEmail = false } = Astro.props;
const mailto = `mailto:${company.email}`;
---

<section id="contact" class="cta" data-surface="inverse">
  <div class="wrap cta__inner">
    {label && <p class="label">{label}</p>}
    <h2 class:list={['cta__statement', `cta__statement--${size}`]}>{cta.statement}</h2>
    <div class="cta__row">
      <p class="cta__text">{cta.body}</p>
      <div class="cta__actions">
        <Button href={mailto} size="lg" arrow>{ui.talk}</Button>
        {showEmail && <a class="cta__email" href={mailto}>{company.email}</a>}
      </div>
    </div>
  </div>
</section>

<style>
  .cta { scroll-margin-top: var(--header-h); }

  .cta__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(var(--space-40), 5vw, var(--space-2xl));
    padding-block: var(--section-y-lg);
  }

  .cta__inner > .label { margin: 0; }

  .cta__statement {
    margin: 0;
    max-width: 14ch;
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-display);
    color: var(--ink-strong);
    text-wrap: balance;
  }
  .cta__statement--display    { font-size: var(--text-display);    line-height: var(--leading-display); }
  .cta__statement--display-sm { font-size: var(--text-display-sm); line-height: 1; }

  .cta__row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-28) var(--space-xl);
    padding-top: var(--space-28);
    border-top: var(--border-hair) solid var(--line);
  }

  .cta__text {
    margin: 0;
    max-width: 56ch;
    font-size: var(--text-lede);
    line-height: 1.65;
    color: var(--ink-soft);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-28);
  }

  .cta__email {
    color: var(--ink);
    font-size: var(--text-ui-lg);
    text-decoration: none;
  }
  .cta__email:hover { color: var(--ink-strong); text-decoration: underline; }
</style>
