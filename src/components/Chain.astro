---
/**
 * A left-to-right transformation chain: Pixels -> Object -> Location -> ...
 * Wraps on narrow viewports instead of scrolling. The arrows are decorative;
 * the ordered list carries the sequence.
 */
interface Props {
  caption: string;
  steps: string[];
  emphasis?: boolean;
}
const { caption, steps, emphasis = false } = Astro.props;
---

<figure class:list={['chain', emphasis && 'chain--emphasis']}>
  <figcaption class="chain__caption">{caption}</figcaption>
  <ol class="chain__list">
    {steps.map((step, i) => (
      <li class="chain__item">
        <span class="chain__node">{step}</span>
        {i < steps.length - 1 && <span class="chain__arrow" aria-hidden="true">&#8594;</span>}
      </li>
    ))}
  </ol>
</figure>

<style>
  .chain {
    margin: 0;
    padding: var(--space-md);
    border: var(--border-hair) solid var(--line);
    background-color: var(--surface);
  }

  .chain--emphasis {
    border-color: var(--line-accent);
    background-color: var(--surface-accent);
  }

  .chain__caption {
    font-size: var(--text-caption);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: var(--space-sm);
  }

  .chain--emphasis .chain__caption { color: var(--accent); }

  .chain__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chain__item { display: inline-flex; align-items: center; }

  .chain__node {
    display: inline-block;
    padding: var(--space-3xs) var(--space-2xs);
    font-size: var(--text-sm);
    font-weight: var(--weight-regular);
    color: var(--ink);
    white-space: nowrap;
  }

  .chain--emphasis .chain__node { font-weight: var(--weight-medium); }

  .chain__item:last-child .chain__node { color: var(--accent); font-weight: var(--weight-medium); }

  .chain__arrow {
    color: var(--ink-muted);
    font-size: var(--text-sm);
    padding-inline: var(--space-3xs);
  }

  .chain--emphasis .chain__arrow { color: var(--accent); }
</style>
