---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { nav, navCta, company, ui } from '@content/site';

interface Props {
  /** Float over a full-bleed hero (home) instead of taking space in the flow. */
  overlay?: boolean;
  /** Where "Talk to us" points — the page's own #contact band by default. */
  contactHref?: string;
}

const { overlay = false, contactHref = navCta.href } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class:list={['site-header', { 'site-header--overlay': overlay }]}>
  <a class="visually-hidden skip" href="#main">{ui.skip}</a>
  <div class="wrap site-header__inner">
    <a href="/" class="site-header__home" aria-label={`${company.name} — home`}>
      <!-- Dark ground → platinum-ink lockup (D8: ink is explicit, never inferred) -->
      <Logo ink="platinum" height={44} label="" />
    </a>

    <nav aria-label="Primary" class="site-nav">
      <ul role="list" class="site-nav__list">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="site-nav__link"
              aria-current={path === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <Button href={contactHref} size="sm" arrow>{navCta.label}</Button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background-color: var(--header-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: var(--border-hair) solid var(--line-overlay);
  }

  .site-header--overlay {
    position: fixed;
    inset-inline: 0;
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-lg);
    min-height: var(--header-h);
    padding-block: var(--space-2xs);
  }

  .site-header__home {
    display: inline-flex;
    text-decoration: none;
  }

  .skip {
    position: absolute;
    inset-inline-start: var(--space-sm);
    inset-block-start: var(--space-sm);
    z-index: var(--z-overlay);
    background-color: var(--surface-raised);
    color: var(--ink-strong);
    padding: var(--space-2xs) var(--space-sm);
    border: var(--border-hair) solid var(--accent);
    border-radius: var(--radius-md);
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) clamp(var(--space-sm), 2.5vw, var(--space-36));
  }

  .site-nav__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) clamp(var(--space-sm), 2.5vw, var(--space-36));
    margin: 0;
    padding: 0;
  }

  .site-nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    border-bottom: var(--border-rule) solid transparent;
    transition: color var(--duration-fast) var(--ease), border-color var(--duration-fast) var(--ease);
  }

  .site-nav__link:hover { color: var(--ink-strong); text-decoration: none; }

  .site-nav__link[aria-current='page'] {
    color: var(--ink-strong);
    border-bottom-color: var(--accent);
  }
</style>
