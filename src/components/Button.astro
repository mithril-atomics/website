---
/**
 * Link or button. No shadows, no gradients, no glow — depth is a hairline.
 * Touch target is >=44px tall in every variant.
 */
interface Props {
  href?: string;
  variant?: 'solid' | 'outline' | 'quiet';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  [key: string]: unknown;
}

const { href, variant = 'solid', type = 'button', class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
const external = typeof href === 'string' && /^https?:\/\//.test(href);
---

<Tag
  href={href}
  type={href ? undefined : type}
  rel={external ? 'noopener noreferrer' : undefined}
  target={external ? '_blank' : undefined}
  class:list={['btn', `btn--${variant}`, className]}
  {...rest}
>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    min-height: 44px;
    padding: var(--space-2xs) var(--space-md);
    border: var(--border-hair) solid transparent;
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-body);
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease),
      border-color var(--duration-fast) var(--ease),
      color var(--duration-fast) var(--ease);
  }

  .btn--solid {
    background-color: var(--accent);
    border-color: var(--accent);
    color: var(--ink-on-accent);
  }
  .btn--solid:hover { background-color: var(--accent-hover); border-color: var(--accent-hover); color: var(--ink-on-accent); }

  .btn--outline {
    background-color: transparent;
    border-color: var(--line-strong);
    color: var(--ink);
  }
  .btn--outline:hover { border-color: var(--accent); color: var(--accent); }

  .btn--quiet {
    background-color: transparent;
    border-color: transparent;
    color: var(--accent);
    padding-inline: var(--space-2xs);
  }
  .btn--quiet:hover { color: var(--accent-hover); text-decoration: underline; text-underline-offset: 0.2em; }
</style>
