---
/**
 * One person: 4:5 portrait (monochrome, colour on hover — D11), name, caps
 * role, optional bio, LinkedIn button. Bio and LinkedIn render only when set.
 */
import { ui, isSet } from '@content/site';

interface Props {
  name: string;
  role: string;
  bio?: string;
  photo?: string;
  linkedin?: string;
  /** Compact = home preview: portrait links to LinkedIn, no bio, no button. */
  compact?: boolean;
}

const { name, role, bio, photo, linkedin, compact = false } = Astro.props;
const hasLinkedIn = isSet(linkedin);
const liLabel = ui.onLinkedIn(name);
---

<li class:list={['person', { 'person--compact': compact }]}>
  {photo && (
    compact && hasLinkedIn ? (
      <a class="person__photo" href={linkedin} target="_blank" rel="noopener noreferrer" aria-label={liLabel}>
        <img src={photo} alt={ui.portraitAlt(name)} width="640" height="800" loading="lazy" decoding="async" />
      </a>
    ) : (
      <div class="person__photo">
        <img src={photo} alt={ui.portraitAlt(name)} width="640" height="800" loading="lazy" decoding="async" />
      </div>
    )
  )}

  <div class="person__id">
    <h3 class="person__name">{name}</h3>
    <p class="person__role">{role}</p>
  </div>

  {!compact && isSet(bio) && <p class="person__bio">{bio}</p>}

  {!compact && hasLinkedIn && (
    <a class="person__li" href={linkedin} target="_blank" rel="noopener noreferrer" aria-label={liLabel}>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
        <rect width="4" height="12" x="2" y="9" />
        <circle cx="4" cy="4" r="2" />
      </svg>
      {ui.linkedin}
      <svg class="person__ext" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M7 7h10v10" /><path d="M7 17 17 7" />
      </svg>
    </a>
  )}
</li>

<style>
  .person {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    min-width: 0;
  }
  .person--compact { gap: var(--space-14); }

  .person__photo {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background-color: var(--surface-media);
    border-radius: var(--radius-sm);
  }

  .person__photo img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    filter: var(--portrait-filter);
    transition: filter var(--duration-slow) var(--ease);
  }

  .person:hover .person__photo img,
  .person__photo:focus-visible img { filter: none; }

  .person__id { display: flex; flex-direction: column; gap: var(--space-6); }
  .person--compact .person__id { gap: var(--space-3xs); }

  .person__name {
    margin: 0;
    font-size: var(--text-person);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-heading);
    color: var(--ink-strong);
  }
  .person--compact .person__name { font-size: var(--text-lg); line-height: 1.3; }

  .person__role {
    margin: 0;
    font-size: var(--text-ui-xs);
    font-weight: var(--weight-medium);
    line-height: 1.4;
    letter-spacing: var(--tracking-role);
    text-transform: uppercase;
    color: var(--accent);
  }

  .person__bio {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--ink-soft);
  }

  .person__li {
    margin-top: auto;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 44px;
    padding: 0 var(--space-14);
    border: var(--border-hair) solid var(--line-strong);
    border-radius: var(--radius-md);
    color: var(--ink-strong);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease),
      background-color var(--duration-fast) var(--ease);
  }
  .person__li:hover {
    border-color: var(--accent);
    background-color: var(--btn-tint);
    color: var(--ink-strong);
    text-decoration: none;
  }

  .person__li svg {
    inline-size: 1rem;
    block-size: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex: none;
  }
  .person__li .person__ext { inline-size: var(--space-14); block-size: var(--space-14); }
</style>
