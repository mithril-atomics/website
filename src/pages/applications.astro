---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/Section.astro';
import { pages } from '@content/site';

const page = pages.applications;
---

<BaseLayout title={page.title} description={page.description}>
  <Section heading={page.hero.heading} lede={page.hero.lede} class="page-hero" />

  {page.sections.map((s) => (
    <Section label={s.label} heading={s.heading} lede={s.lede} headingLevel={3}>
      {s.items && (
        <ul role="list" class="grid">
          {s.items.map((item) => (
            <li class="card">
              <h4>{item.title}</h4>
              <p class="muted">{item.body}</p>
            </li>
          ))}
        </ul>
      )}
    </Section>
  ))}
</BaseLayout>

<style>
  .card {
    padding: var(--space-lg);
    background-color: var(--surface-raised);
    border: var(--border-hair) solid var(--line);
    border-radius: var(--radius-lg);
  }
  .card h4 { margin-bottom: var(--space-2xs); }
  .card p { margin: 0; }
</style>
